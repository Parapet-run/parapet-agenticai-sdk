# Copy to .env for CLOUD mode (a real Parapet control plane -- the default
# this demo runs in: `cp .env.cloud .env`). The parapet-quickdemo skill
# generates the filled-in .env AND .env.cloud for you automatically, right
# after provisioning -- edit by hand only if you're running this demo
# without the skill, or restoring cloud mode after testing with .env.local
# (see README.md's "Switching between cloud and local mode").

PARAPETAI_MODE=cloud

# --- Model: mock by default -------------------------------------------
# Leave OPENAI_API_KEY unset (or "mock") to use the built-in local mock
# model server -- no network call, no cost, fully deterministic. Set a
# real key here to use a real OpenAI-compatible model instead; the agent
# code is identical either way.
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# --- Governed agent: required in cloud mode ----------------------------
# From `parapet_provision_agent` (via the parapet-quickdemo skill, or the
# control plane console). The secret is shown once at provisioning time --
# if you don't have it anymore, rotate the agent's key on the control
# plane and paste the new one here.
PARAPETAI_AGENT_ID=
PARAPETAI_AGENT_SECRET=
PARAPETAI_CONTROL_PLANE_URL=https://app.parapet.run

# Every agent page is scoped under /a/{account_id}/... -- from
# parapet_whoami's account_id field. Needed to print a working link, not
# just to run the demo.
PARAPETAI_ACCOUNT_ID=

# --- Local debug cache of the fetched control-plane bundle --------------
# On by default: every cloud-mode run writes the org policy it just
# fetched from the control plane into this directory, so you can diff it
# against ./policies/40-org.cedar (the local-mode copy of the same rule)
# when a decision looks wrong. This is a disposable debug artifact, not a
# source of truth -- see README.md's "Deployment" section before shipping
# this project anywhere. Already covered by .gitignore. Set to an empty
# value to turn writing it off.
PARAPETAI_PERSIST_POLICY_DIR=.parapet-cache/policies
