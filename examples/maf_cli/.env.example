# Copy to .env and source it (or export these directly) before running
# run_example.py against real Azure OpenAI. See README.md for how to get
# each value from your Azure AI Foundry deployment. No ENTRA_*/WEB_APP_PORT/
# APIFY_* vars here -- unlike examples/maf_webapp/, this example has no web
# server, no session cookies, and no Entra login of its own.

# Resource root, e.g. https://my-resource.openai.azure.com/ -- not a full
# chat-completions path.
AZURE_OPENAI_ENDPOINT=

# From the deployment's Endpoint tab in Foundry, or the resource's Keys and
# Endpoint blade in the classic Azure Portal.
AZURE_OPENAI_API_KEY=

# The DEPLOYMENT name you chose when deploying the model, not the model
# family name -- see examples/maf_webapp/README.md "Which model" for why
# gpt-5-mini is this repo's default pick.
AZURE_OPENAI_CHAT_COMPLETION_MODEL=gpt-5-mini

# Optional. Defaults to 2024-12-01-preview if unset -- only set this if your
# deployment needs a different API version.
# AZURE_OPENAI_API_VERSION=

# Optional -- governs this script by a real control-plane-provisioned
# agent's bundle instead of the repo's own local policies/ (this example
# passes policy_dir=POLICIES explicitly -- see run_example.py's own
# module docstring for why -- so that's the fallback here, not the
# parapetai-agent bundled default the other maf_sample_0N/ examples fall back
# to). Get all three from the control plane's web UI after provisioning
# an agent there (http://127.0.0.1:8090/agents/new) -- it prints exactly
# this block once, right after provisioning. THIS example's own agent,
# not examples/maf_webapp's -- see README.md "Its own agent" for why
# each example is governed by a separate control-plane-provisioned
# identity, not a shared one. Leave unset to skip cleanly -- this script
# then runs against local policies/ the whole time. The pulled bundle
# stays in memory only (never written to disk).
# PARAPETAI_CONTROL_PLANE_URL=http://127.0.0.1:8090
# PARAPETAI_AGENT_SECRET=
# PARAPETAI_AGENT_ID=
