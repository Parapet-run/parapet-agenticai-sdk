# Copy to .env and fill in real values before running run_example.py.
# Gitignored -- same bare `.env` rule as every other example in this
# directory.
#
# This example uses the Gemini Developer API -- the lowest-friction real
# ADK auth path (no GCP project, no Application Default Credentials,
# unlike Vertex AI/Gemini Enterprise). Confirmed directly against the
# installed google-genai Client's own source: it defaults to Developer
# API mode whenever GOOGLE_API_KEY is set.

# Get one at https://aistudio.google.com/apikey (free tier available).
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional -- overrides run_example.py's own default model id. Google
# retires/renames Gemini model ids faster than this file gets updated; if
# the default 404s with "no longer available", the API's own error
# message names the current replacement -- set it here.
# GOOGLE_MODEL=gemini-3.6-flash

# Optional -- governs this script by a real control-plane-provisioned
# agent's bundle instead of the policy set bundled with parapetai-agent
# (base permits -- see run_example.py's own module docstring). Get all
# three from the control plane's agent detail page ("Integrating this
# agent") after provisioning an agent there. THIS example's own agent,
# not maf_sample_0N/'s or another adk_sample_0N/'s. Leave unset to run
# against the bundled default -- the Cedar principal itself then falls
# back to Agent::"anonymous" too (still evaluated by default-deny, never
# a bypass; set PARAPETAI_AGENT_ID for a real name once you have one).
# PARAPETAI_AGENT_ID=pa-xxxxxxxxxxxx
# PARAPETAI_AGENT_SECRET=<printed once on the agent detail page after provisioning>
# PARAPETAI_CONTROL_PLANE_URL=http://localhost:8090
