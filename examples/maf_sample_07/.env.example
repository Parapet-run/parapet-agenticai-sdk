# Copy to .env and fill in real values before running run_example.py.
# Gitignored -- same bare `.env` rule as every other example in this
# directory.

# --- Plain OpenAI (this sample's default -- see run_example.py's own
# module docstring for why this one uses OpenAI instead of Azure OpenAI
# like the other maf_sample_0N/ examples) ---
OPENAI_API_KEY=
OPENAI_CHAT_COMPLETION_MODEL=gpt-4o-mini

# --- OR Azure OpenAI instead ---
# OpenAIChatCompletionClient() auto-detects which routing to use from
# whichever of these two blocks is actually set -- leave the OpenAI block
# above entirely empty/unset to use this one.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_COMPLETION_MODEL=gpt-5-mini
# AZURE_OPENAI_API_VERSION=

# Optional -- governs this script by a real control-plane-provisioned
# agent's bundle instead of the policy set bundled with parapetai-agent
# (base permits). Get all three from the control plane's agent detail
# page ("Integrating this agent") after provisioning an agent there.
# THIS example's own agent, not a different maf_sample_0N/'s. Leave
# unset to run against the bundled default -- the Cedar principal itself
# then falls back to Agent::"anonymous" too (still evaluated by
# default-deny, never a bypass). The pulled bundle stays in memory only
# (never written to disk).
# PARAPETAI_CONTROL_PLANE_URL=http://127.0.0.1:8090
# PARAPETAI_AGENT_SECRET=
# PARAPETAI_AGENT_ID=
