# Copy to .env and fill in real values before running web_app.py.
# Gitignored -- same bare `.env` rule as every other example in this
# directory.
#
# This example uses the Gemini Developer API -- see adk_sample_01/
# .env.example for why (lowest-friction real ADK auth path).

# Get one at https://aistudio.google.com/apikey (free tier available).
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional -- overrides web_app.py's own default model id. See
# adk_sample_01/.env.example for why this exists (Google retires Gemini
# model ids faster than this file gets updated).
# GOOGLE_MODEL=gemini-3.6-flash

# Optional -- governs this app by a real control-plane-provisioned agent's
# bundle instead of the policy set bundled with parapetai-agent (base
# permits + policies/30-identity.cedar's OrderViewer role gate -- see
# web_app.py's own module docstring). Get all three from the control
# plane's agent detail page ("Integrating this agent") after provisioning
# an agent there. THIS example's own agent, not adk_sample_01/'s or
# maf_webapp/'s.
# PARAPETAI_AGENT_ID=pa-xxxxxxxxxxxx
# PARAPETAI_AGENT_SECRET=<printed once on the agent detail page after provisioning>
# PARAPETAI_CONTROL_PLANE_URL=http://localhost:8090
