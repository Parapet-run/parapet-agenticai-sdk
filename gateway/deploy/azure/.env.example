# Copy to .env (gitignored) in this directory and fill in real values.
# deploy-gateway.sh sources this automatically.
#
# There is no local Cedar policy in this deployment -- PARAPETAI_CONTROL_PLANE_URL/
# PARAPETAI_AGENT_ID/PARAPETAI_AGENT_SECRET are REQUIRED, not optional: the
# gateway's own PolicyEngine has nothing to load from until the first bundle
# fetch succeeds (server/main.py runs that fetch synchronously, before
# constructing the engine, precisely so no .cedar file ever needs to ship
# baked into the image or this deploy directory).

# ── Control plane (required) ────────────────────────────────────────────
# From your Parapet control-plane dashboard -- provision an agent there (or
# via parapetai-mcp's parapet_provision_agent tool) to get these two values.
PARAPETAI_CONTROL_PLANE_URL=
PARAPETAI_AGENT_ID=
PARAPETAI_AGENT_SECRET=

# ── Downstream MCP server(s) this gateway fronts ────────────────────────
# The gateway is a reverse proxy for an ARBITRARY set of downstream MCP
# servers, not one fixed one -- pick ONE of the two below depending on how
# many you have. Every value must be reachable FROM Azure (i.e. not
# localhost) -- an internal/private endpoint your own network can reach, or
# a public HTTPS one. Each is the server's COMPLETE endpoint URL (a
# Streamable HTTP MCP server has exactly one), not just a host.

# Single downstream server: PARAPETAI_MCP_BASE_URL. Callers hit bare
# /a/<agent-id>/mcp.
PARAPETAI_MCP_BASE_URL=

# Multiple downstream servers, fronted by this one gateway/one policy set/
# one control-plane identity: PARAPETAI_MCP_UPSTREAMS, a JSON object mapping
# a target name to its complete endpoint URL. Callers hit
# /a/<agent-id>/mcp/<target-name> -- e.g. with the example below,
# /a/<agent-id>/mcp/jira and /a/<agent-id>/mcp/github route independently.
# Register EACH resulting URL as its own separate Atlassian "external MCP
# server" (gateway/deploy/azure/README.md's step 8). The target name is also
# exposed to Cedar as context.mcp_target, so a policy can gate access
# per-downstream-server, not just per-tool-name within one.
# PARAPETAI_MCP_UPSTREAMS={"jira":"https://jira-mcp.internal:9000/mcp","github":"https://github-mcp.example.com/mcp"}

# ── MCP auth mode ────────────────────────────────────────────────────────
# "none": /mcp is reachable with no bearer credential (today's default --
#   good for a first end-to-end smoke test with curl or conformance/mcp-probe
#   before wiring up Rovo). Cedar still governs every call either way.
# "oauth2": required before Atlassian Rovo will register this as a custom/
#   external MCP server -- it enforces the MCP Authorization spec (OAuth 2.1
#   authorization_code+PKCE, Dynamic Client Registration) against whatever
#   URL you give it. See gateway/deploy/azure/README.md for the Rovo-side
#   registration steps.
PARAPETAI_MCP_AUTH_MODE=none

# Required only when PARAPETAI_MCP_AUTH_MODE=oauth2 -- generate with
# `openssl rand -base64 32`. Gates the one-time /authorize consent step; see
# gateway/src/parapetai_gateway/mcp_oauth.py's module docstring for exactly
# what this does and does not protect (Cedar remains the real authorization
# decision regardless of this value).
PARAPETAI_MCP_OAUTH_SHARED_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────
# enforce (default) blocks denied calls; monitor logs what WOULD have been
# blocked without blocking it.
PARAPETAI_MODE=enforce
# OTLP collector endpoint for decision spans/logs (docs/OBSERVABILITY.md).
# Leave unset to skip OTel export entirely.
PARAPETAI_OTLP_ENDPOINT=
